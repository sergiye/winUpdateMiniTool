<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>wu.ico</ApplicationIcon>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net8.0-windows' ">
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <Reference Include="System.Design" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <PropertyGroup>
    <UseLocalCommon Condition=" '$(UseLocalCommon)' == '' AND Exists('..\..\common\sergiye.Common') ">true</UseLocalCommon>
  </PropertyGroup>
  <ItemGroup Condition=" '$(UseLocalCommon)' == 'true' ">
    <Compile Include="..\..\common\sergiye.Common\Tools\Updater.cs" Link="Common\Updater.cs" />
    <Compile Include="..\..\common\sergiye.Common\Extensions\JsonExtensions.cs" Link="Common\JsonExtensions.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\OSHelper.cs" Link="Common\OSHelper.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\MultiValueDictionary.cs" Link="Common\MultiValueDictionary.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\TokenManipulator.cs" Link="Common\TokenManipulator.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\AppLog.cs" Link="Common\AppLog.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\FileOps.cs" Link="Common\FileOps.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\ProcessManager.cs" Link="Common\ProcessManager.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\HttpTask.cs" Link="Common\HttpTask.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\KnownFolders.cs" Link="Common\KnownFolders.cs" />
    <Compile Include="..\..\common\sergiye.Common\Tools\StartupManager.cs" Link="Common\StartupManager.cs" />
    <Compile Include="..\..\common\sergiye.Common\Win\TaskScheduler.cs" Link="Common\TaskScheduler.cs" />
    <Compile Include="..\..\common\sergiye.Common\Win\WinConsole.cs" Link="Common\WinConsole.cs" />
    <Compile Include="..\..\common\sergiye.Common\Win\WinServiceHelper.cs" Link="Common\WinServiceHelper.cs" />
    <Compile Include="..\..\common\sergiye.Common\Win\WinApiHelper.cs" Link="Common\WinApiHelper.cs" />
    <Compile Include="..\..\common\sergiye.Common\Win\ProcessNativeMethods.cs" Link="Common\ProcessNativeMethods.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\Theme.cs" Link="Common\Themes\Theme.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\LightTheme.cs" Link="Common\Themes\LightTheme.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\DarkTheme.cs" Link="Common\Themes\DarkTheme.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\CustomTheme.cs" Link="Common\Themes\CustomTheme.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemeSupport.cs" Link="Common\Themes\ThemeSupport.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemeDraw.cs" Link="Common\Themes\ThemeDraw.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemedProfessionalRenderer.cs" Link="Common\Themes\ThemedProfessionalRenderer.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemedControlBorder.cs" Link="Common\Themes\ThemedControlBorder.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemedTitleBar.cs" Link="Common\Themes\ThemedTitleBar.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\Themes\ThemedWindowTitle.cs" Link="Common\Themes\ThemedWindowTitle.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\ToolStripRadioButtonMenuItem.cs" Link="Common\ToolStripRadioButtonMenuItem.cs" />
    <Compile Include="..\..\common\sergiye.Common.UI\ListViewExtended.cs" Link="Common\ListViewExtended.cs" />
    <EmbeddedResource Include="..\..\common\themes\*.json" Link="themes\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition=" '$(UseLocalCommon)' != 'true' ">
    <PackageReference Include="SergiyE.Common" Version="1.*" />
    <PackageReference Include="SergiyE.Common.UI" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Common\ListViewExtended.cs" SubType="Component" />
    <Compile Update="*Form.cs" SubType="Form" />
    <Compile Update="MainForm.Designer.cs" DependentUpon="MainForm.cs" />
    <EmbeddedResource Update="MainForm.resx" DependentUpon="MainForm.cs" />
    <None Update="app.manifest" SubType="Designer" />
  </ItemGroup>
  <ItemGroup>
    <COMReference Include="TaskScheduler">
      <Guid>{E34CB9F1-C7F7-424C-BE29-027DCC09363A}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="WUApiLib">
      <Guid>{B596CC9F-56E5-419E-A622-E01BB457431E}</Guid>
      <VersionMajor>2</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="wu.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="Costura.Fody" Version="4.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0-windows' ">
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
  <!-- Keeps only the executable, but spares the culture sub folders: they hold the localized
       resources, and Costura is configured not to embed satellite assemblies. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net472' ">
    <Exec Command="for %%f in ($(OutDir)\*) do if not %%~xf==.exe if not exist &quot;%%f\&quot; del /S /Q &quot;%%f&quot;" />
  </Target>
</Project>
